{
  "name": "mediagui-shell",
  "version": "0.1.1",
  "description": "MediaGUI desktop shell (Electron) over the Go daemon API",
  "private": true,
  "author": "Glob876",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --mock",
    "package": "electron-builder",
    "package:linux": "electron-builder --linux",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.mogdop.mediagui",
    "productName": "MediaGUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "include": "installer/include.nsh",
      "installerSidebar": "installer/sidebar.bmp",
      "uninstallerSidebar": "installer/sidebar.bmp",
      "installerHeader": "installer/header.bmp",
      "installerIcon": "installer/icon.ico",
      "uninstallerIcon": "installer/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "electron-winstaller@5.4.0": true
  }
}
